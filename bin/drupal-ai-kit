#!/usr/bin/env bash
#
# Copies the kit from vendor/ into the project and runs .ai-kit/install.sh.
#
#   vendor/bin/drupal-ai-kit init <tool>...   first install: AGENTS.md (if missing), .ai-kit/, .gitignore, tools
#   vendor/bin/drupal-ai-kit update           after `composer update`: refresh .ai-kit/ and the installed tools
#
# AGENTS.md belongs to the project: it is copied once and never overwritten.
# .ai-kit/ belongs to the kit: `update` replaces it as a whole, so project rules go to AGENTS.md.

set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
kit="$(cd "$(dirname "$self")/.." && pwd)"

usage() {
  sed -n '3,9p' "$self" | sed 's/^# \{0,1\}//'
}

if [[ ! -f composer.json ]]; then
  echo "Run this from the project root (where composer.json is)." >&2
  exit 1
fi

if [[ "$kit" == "$(pwd)" ]]; then
  echo "This is the kit itself: run .ai-kit/install.sh here." >&2
  exit 1
fi

# Replaces .ai-kit/ with the kit's copy, keeping the install state.
sync_kit() {
  mkdir -p .ai-kit
  rsync -a --delete --exclude /.installed --exclude .DS_Store "$kit/.ai-kit/" .ai-kit/
}

# Adds the generated folders to .gitignore, as README.md describes.
ensure_gitignore() {
  local entries=(
    .ai-kit/.installed/
    .claude/
    .codex/
    .github/copilot-instructions.md
    .github/git-commit-instructions.md
    .github/instructions/
    .github/prompts/
  )
  local dir line added=0

  # A project that commits its own skills in .agents/skills/ gets the kit's
  # skill folders by name instead of the whole folder.
  if [[ -n "$(git ls-files .agents/skills 2> /dev/null)" ]]; then
    for dir in "$kit"/.ai-kit/skills/*/; do
      entries+=(".agents/skills/$(basename "$dir")/")
    done
  else
    entries+=(.agents/skills/)
  fi

  touch .gitignore
  for line in "${entries[@]}"; do
    if ! grep -qxF "$line" .gitignore; then
      if [[ $added -eq 0 ]]; then
        printf '\n# drupal-ai-kit: generated by .ai-kit/install.sh\n' >> .gitignore
        added=1
      fi
      echo "$line" >> .gitignore
    fi
  done
}

case "${1:-}" in
  init)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Name the tools: vendor/bin/drupal-ai-kit init claude [codex] [copilot]" >&2
      exit 2
    fi
    if [[ -e AGENTS.md ]]; then
      echo "AGENTS.md exists: kept."
    else
      cp "$kit/AGENTS.md" AGENTS.md
      echo "AGENTS.md copied."
    fi
    sync_kit
    ensure_gitignore
    .ai-kit/install.sh "$@"
    echo "Next: run the generate-agents-md skill to adapt AGENTS.md to this project, then commit AGENTS.md, .ai-kit/ and .gitignore."
    ;;
  update)
    sync_kit
    .ai-kit/install.sh
    ;;
  -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
