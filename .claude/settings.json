{
  "model": "opus",
  "alwaysThinkingEnabled": false,
  "language": "ukrainian",
  "env": {
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r --arg t \"$(date '+%F %T')\" '\"\\($t) subagent finished: \\((.tool_input.subagent_type // \"\") | if . == \"\" then \"general/fork\" else . end) — \\(.tool_input.description // \"\")\"' >> \"$CLAUDE_PROJECT_DIR/.claude/agents.log\""
          }
        ]
      }
    ]
  },
  "tools": {
    "bash": true,
    "git": true,
    "filesystem": true
  },
  "context": {
    "include": [
      "src/**",
      "web/modules/custom/**",
      "web/themes/custom/**",
      "app/**",
      "config/**",
      "composer.json",
      "package.json",
      "README.md"
    ],
    "exclude": [
      "node_modules/**",
      "vendor/**",
      ".git/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "*.log"
    ]
  }
}
